RFC 003: Database Schema (SQLite)
The core SQLite schema supporting characters, locations, items, inventories, skills, spatial containers, and ground resources:

-- Locations Table
CREATE TABLE locations (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    owner_id TEXT,
    is_public_property BOOLEAN DEFAULT 0,
    is_indoor BOOLEAN DEFAULT 0,
    vehicle_access_tier TEXT DEFAULT 'ALL', -- 'ALL', 'FOOT_AND_WHEELBARROW', 'FOOT_ONLY'
    open_time TEXT,
    close_time TEXT,
    rules_prompt TEXT,
    FOREIGN KEY (owner_id) REFERENCES characters(id)
);

-- Location Operators
CREATE TABLE location_operators (
    location_id TEXT NOT NULL,
    character_id TEXT NOT NULL,
    granted_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (location_id, character_id),
    FOREIGN KEY (location_id) REFERENCES locations(id) ON DELETE CASCADE,
    FOREIGN KEY (character_id) REFERENCES characters(id) ON DELETE CASCADE
);

-- Location Ground Items (Unburdened / Dropped Items)
CREATE TABLE location_items (
    location_id TEXT NOT NULL,
    item_id TEXT NOT NULL,
    quantity INTEGER NOT NULL DEFAULT 1,
    dropped_by TEXT,
    dropped_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (location_id, item_id),
    FOREIGN KEY (location_id) REFERENCES locations(id) ON DELETE CASCADE,
    FOREIGN KEY (item_id) REFERENCES items(id) ON DELETE CASCADE
);

-- Location Dynamic Ecological Resource Pools
CREATE TABLE location_resources (
    location_id TEXT NOT NULL,
    resource_id TEXT NOT NULL,
    current_stock INTEGER NOT NULL DEFAULT 100,
    max_stock INTEGER NOT NULL DEFAULT 100,
    replenish_rate_per_day INTEGER NOT NULL DEFAULT 20,
    PRIMARY KEY (location_id, resource_id),
    FOREIGN KEY (location_id) REFERENCES locations(id) ON DELETE CASCADE
);

-- Communal farm crop definitions and persistent plots
CREATE TABLE farm_crops (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    seed_item_id TEXT NOT NULL,
    harvest_item_id TEXT NOT NULL,
    growth_ticks INTEGER NOT NULL,
    yield_quantity INTEGER NOT NULL,
    FOREIGN KEY (seed_item_id) REFERENCES items(id),
    FOREIGN KEY (harvest_item_id) REFERENCES items(id)
);

CREATE TABLE farm_plots (
    id TEXT PRIMARY KEY,
    location_id TEXT NOT NULL,
    crop_id TEXT,
    planted_tick INTEGER NOT NULL DEFAULT 0,
    mature_tick INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (location_id) REFERENCES locations(id) ON DELETE CASCADE,
    FOREIGN KEY (crop_id) REFERENCES farm_crops(id)
);

-- Characters Table
CREATE TABLE characters (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    persona_prompt TEXT NOT NULL,
    occupation TEXT NOT NULL,
    gold INTEGER NOT NULL DEFAULT 10,
    hunger INTEGER NOT NULL DEFAULT 100,
    energy INTEGER NOT NULL DEFAULT 100,
    current_location TEXT NOT NULL DEFAULT 'town_square',
    equipped_container_id TEXT,
    status TEXT NOT NULL DEFAULT 'IDLE', -- 'IDLE', 'FORAGING', 'RESTING', 'CRAFTING'
    action_end_tick INTEGER DEFAULT 0,
    is_online BOOLEAN NOT NULL DEFAULT 0,
    controller_type TEXT NOT NULL DEFAULT 'agent',
    mqtt_password TEXT NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (current_location) REFERENCES locations(id),
    FOREIGN KEY (equipped_container_id) REFERENCES items(id)
);

-- Character Skills Table (Skill-based progression through practice)
CREATE TABLE character_skills (
    character_id TEXT NOT NULL,
    skill_id TEXT NOT NULL, -- 'foraging', 'woodcutting', 'herbalism', etc.
    level INTEGER NOT NULL DEFAULT 1,
    experience INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (character_id, skill_id),
    FOREIGN KEY (character_id) REFERENCES characters(id) ON DELETE CASCADE
);

-- Items Table (Mass, Container & Consumable Properties)
CREATE TABLE items (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT,
    weight_kg REAL NOT NULL DEFAULT 0.1,
    is_consumable BOOLEAN DEFAULT 0,
    hunger_restore INTEGER DEFAULT 0,
    is_container BOOLEAN DEFAULT 0,
    capacity_kg REAL DEFAULT 0.0,
    slot_limit INTEGER DEFAULT 0
);

-- Inventories Table
CREATE TABLE inventories (
    character_id TEXT NOT NULL,
    item_id TEXT NOT NULL,
    quantity INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (character_id, item_id),
    FOREIGN KEY (character_id) REFERENCES characters(id),
    FOREIGN KEY (item_id) REFERENCES items(id)
);

-- Location Connections Graph Table (Spatial Graph)
CREATE TABLE location_connections (
    from_location_id TEXT NOT NULL,
    to_location_id TEXT NOT NULL,
    travel_ticks INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (from_location_id, to_location_id),
    FOREIGN KEY (from_location_id) REFERENCES locations(id) ON DELETE CASCADE,
    FOREIGN KEY (to_location_id) REFERENCES locations(id) ON DELETE CASCADE
);

### Spatial Graph Topology & Design Rationale
- **Hub Connectivity (Complete Graph / Clique):** All central village amenities (`town_square`, `market`, `tavern`, `town_mill`, `blacksmith`, `bakery`, `church`, `school`, `town_hall`, `lumberjack_lodge`, `herbalist`, `stables`) are fully connected to each other with a travel cost of 1 tick.
- **Rationale:** OurVillage models a compact, walkable village settlement where local buildings are immediately adjacent to one another. Requiring agents to route through the `town_square` for every minor transition between neighboring village buildings (e.g., school to bakery) would add tedious micro-navigation overhead and planning complexity for LLM agents without adding meaningful economic strategy.
- **Outer Zones:** Distant wilderness and production zones (`prairie`, `deep_forest`, `mine`, `riverbank`) require directional routing through specific graph edges with higher travel costs (2 to 5 ticks).
